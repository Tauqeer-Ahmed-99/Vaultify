{
  "expo": {
    "name": "Vaultify",
    "slug": "react-native-assets-app",
    "version": "2.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/45b5b14c-c5a1-448d-9e39-77c1e691f6ea",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/vaultify-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "react-native-assets-app",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vaultify-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f0c29"
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assetsmanagement.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/vaultify-icon.png",
        "backgroundColor": "#0f0c29"
      },
      "package": "com.assetsmanagement.app"
    },
    "web": {
      "favicon": "./assets/vaultify-icon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45b5b14c-c5a1-448d-9e39-77c1e691f6ea"
      }
    },
    "owner": "tauqeerahmed"
  }
}
